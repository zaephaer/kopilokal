---
import { site } from "../data/site";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/menu", label: "Menu" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const cta =
  "inline-flex items-center rounded-full bg-terracotta hover:bg-terracotta-dark transition-colors px-5 py-2.5 text-sm font-semibold text-cream-light";
---

<header class="sticky top-0 z-50 bg-coffee-950/95 backdrop-blur supports-[backdrop-filter]:bg-coffee-950/90 text-cream-light border-b border-coffee-800">
  <nav class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between h-16">
    <a href="/" class="font-display text-xl sm:text-2xl font-semibold tracking-wide text-cream-light">
      Kopi Local
    </a>

    <ul class="hidden md:flex items-center gap-8 font-medium">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "transition-colors hover:text-terracotta",
              currentPath === link.href ? "text-terracotta" : "text-cream-light/90",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class={`hidden md:inline-flex ${cta}`}>
      Chat on WhatsApp
    </a>

    <details class="md:hidden">
      <summary
        aria-label="Menu"
        class="list-none cursor-pointer text-2xl leading-none [&::-webkit-details-marker]:hidden"
      >
        ☰
      </summary>
      <ul class="absolute inset-x-0 top-16 flex flex-col items-start gap-4 px-5 py-4 bg-coffee-950 border-t border-coffee-800 font-medium">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block py-1",
                currentPath === link.href ? "text-terracotta" : "text-cream-light/90",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class={cta}>
            Chat on WhatsApp
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
