---
import Layout from "../layouts/Layout.astro";
import { menu } from "../data/menu";
import { site } from "../data/site";
---

<Layout title="Menu" description="Browse Kopi Local's full menu — signature kopi, espresso bar, non-coffee drinks, toast & light bites, and JB local specials.">
  <!-- Page header -->
  <section class="bg-coffee-950 text-cream-light bg-grain">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-20 text-center">
      <p class="uppercase tracking-[0.3em] text-terracotta text-xs sm:text-sm font-semibold mb-4">
        Kopi Local
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold">Our Menu</h1>
      <p class="mt-4 text-cream-light/80 max-w-xl mx-auto leading-relaxed">
        Slow-brewed kopi, espresso, and honest JB comfort food — made fresh
        every day.
      </p>
    </div>
  </section>

  <!-- Sticky category nav -->
  <nav
    aria-label="Menu categories"
    class="sticky top-16 z-40 bg-cream-light/95 backdrop-blur border-b border-coffee-900/10"
  >
    <ul class="mx-auto max-w-6xl px-5 sm:px-8 flex gap-6 overflow-x-auto py-3 text-sm font-semibold">
      {menu.map((category) => (
        <li class="shrink-0">
          <a
            href={`#${category.id}`}
            class="text-coffee-800 hover:text-terracotta transition-colors"
          >
            {category.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Menu sections -->
  <div class="bg-cream-light">
    <div class="mx-auto max-w-4xl px-5 sm:px-8 py-16 sm:py-20 space-y-20">
      {menu.map((category) => (
        <section id={category.id} class="scroll-mt-32">
          <div class="mb-8">
            <h2 class="font-display text-2xl sm:text-3xl font-semibold text-coffee-950">
              {category.name}
            </h2>
            <p class="mt-1 text-sm text-coffee-800/70">{category.blurb}</p>
          </div>

          <ul class="divide-y divide-coffee-900/10 border-t border-b border-coffee-900/10">
            {category.items.map((item) => (
              <li class="py-5 flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center flex-wrap gap-x-3 gap-y-1">
                    <h3 class="font-display text-lg font-semibold text-coffee-950">
                      {item.name}
                    </h3>
                    {item.tags?.map((tag) => (
                      <span class="text-[11px] uppercase tracking-wide font-semibold text-sage-dark bg-sage/15 rounded-full px-2.5 py-0.5">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <p class="mt-1 text-sm text-coffee-800/75 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <p class="font-display text-lg font-semibold text-terracotta whitespace-nowrap">
                  {item.price}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <!-- Conversion CTA -->
  <section class="py-16 sm:py-20 bg-coffee-950 text-cream-light text-center bg-grain">
    <div class="mx-auto max-w-2xl px-5 sm:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-4">
        Craving something already?
      </h2>
      <p class="text-cream-light/80 mb-8">
        We're open daily. Drop by, or message us to check today's specials
        and seating.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex justify-center items-center rounded-full bg-terracotta hover:bg-terracotta-dark transition-colors px-8 py-3.5 font-semibold text-cream-light"
        >
          Chat on WhatsApp
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex justify-center items-center rounded-full border border-cream-light/30 hover:border-cream-light/70 transition-colors px-8 py-3.5 font-semibold text-cream-light"
        >
          Get Directions
        </a>
      </div>
    </div>
  </section>
</Layout>
