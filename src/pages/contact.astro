---
import Layout from "../layouts/Layout.astro";

const hours = [
  { day: "Monday – Friday", time: "8:00 AM – 9:00 PM" },
  { day: "Saturday – Sunday", time: "9:00 AM – 10:00 PM" },
  { day: "Public Holidays", time: "9:00 AM – 10:00 PM" },
];

const quickActions = [
  {
    icon: "💬",
    title: "WhatsApp",
    detail: "+60 12-345 6789",
    href: "https://wa.me/60123456789",
    cta: "Chat now",
  },
  {
    icon: "📞",
    title: "Call Us",
    detail: "+60 7-123 4567",
    href: "tel:+60712345678",
    cta: "Call now",
  },
  {
    icon: "✉️",
    title: "Email",
    detail: "hello@kopilocal.my",
    href: "mailto:hello@kopilocal.my",
    cta: "Send email",
  },
];

const mapEmbedSrc =
  "https://www.google.com/maps/embed?pb=!1m2!2m1!1s23%2C+Jalan+Dato+Sulaiman%2C+Taman+Century%2C+80250+Johor+Bahru%2C+Johor%2C+Malaysia";
---

<Layout title="Contact" description="Get in touch with Kopi Local — find our address, opening hours, and how to reach us for reservations, events, and catering.">
  <!-- Page header -->
  <section class="bg-coffee-950 text-cream-light bg-grain">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-20 text-center">
      <p class="uppercase tracking-[0.3em] text-terracotta text-xs sm:text-sm font-semibold mb-4">
        Get In Touch
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold">
        We'd Love to See You
      </h1>
      <p class="mt-4 text-cream-light/80 max-w-xl mx-auto leading-relaxed">
        Questions, reservations, or just want to say hi? Reach out — we
        usually reply within the hour.
      </p>
    </div>
  </section>

  <!-- Quick actions -->
  <section class="bg-cream-light py-14">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 grid sm:grid-cols-3 gap-6">
      {quickActions.map((action) => (
        <a
          href={action.href}
          target={action.href.startsWith("http") ? "_blank" : undefined}
          rel={action.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group rounded-2xl border border-coffee-900/10 bg-white/60 p-6 text-center hover:border-terracotta hover:shadow-lg transition-all"
        >
          <div class="text-3xl mb-3">{action.icon}</div>
          <h3 class="font-display text-lg font-semibold text-coffee-950">
            {action.title}
          </h3>
          <p class="text-sm text-coffee-800/75 mt-1">{action.detail}</p>
          <span class="mt-3 inline-block text-sm font-semibold text-terracotta group-hover:text-terracotta-dark">
            {action.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Map + details + form -->
  <section class="bg-cream-light pb-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 grid lg:grid-cols-2 gap-12">
      <!-- Left: map + address + hours -->
      <div>
        <div class="rounded-2xl overflow-hidden border border-coffee-900/10 shadow-lg aspect-video">
          <iframe
            title="Kopi Local location map"
            src={mapEmbedSrc}
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="mt-8">
          <h3 class="font-display text-xl font-semibold text-coffee-950 mb-2">
            Address
          </h3>
          <p class="text-coffee-800/90 leading-relaxed">
            23, Jalan Dato Sulaiman,<br />
            Taman Century, 80250<br />
            Johor Bahru, Johor, Malaysia
          </p>
        </div>

        <div class="mt-8">
          <h3 class="font-display text-xl font-semibold text-coffee-950 mb-3">
            Opening Hours
          </h3>
          <ul class="divide-y divide-coffee-900/10 border-t border-b border-coffee-900/10">
            {hours.map((h) => (
              <li class="py-3 flex justify-between text-sm">
                <span class="text-coffee-800/90">{h.day}</span>
                <span class="font-semibold text-coffee-950">{h.time}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right: inquiry form -->
      <div>
        <h3 class="font-display text-2xl font-semibold text-coffee-950 mb-2">
          Send an Inquiry
        </h3>
        <p class="text-sm text-coffee-800/75 mb-6">
          For reservations, events, or catering — fill this in and we'll get
          back to you shortly.
        </p>

        <form id="contact-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-coffee-950 mb-1.5">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-coffee-900/20 bg-white px-4 py-2.5 text-coffee-950 placeholder:text-coffee-800/40 focus:outline-none focus:ring-2 focus:ring-terracotta"
              placeholder="Your name"
            />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-semibold text-coffee-950 mb-1.5">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-coffee-900/20 bg-white px-4 py-2.5 text-coffee-950 placeholder:text-coffee-800/40 focus:outline-none focus:ring-2 focus:ring-terracotta"
                placeholder="you@example.com"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-coffee-950 mb-1.5">
                Phone
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full rounded-lg border border-coffee-900/20 bg-white px-4 py-2.5 text-coffee-950 placeholder:text-coffee-800/40 focus:outline-none focus:ring-2 focus:ring-terracotta"
                placeholder="+60 12-345 6789"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-coffee-950 mb-1.5">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full rounded-lg border border-coffee-900/20 bg-white px-4 py-2.5 text-coffee-950 placeholder:text-coffee-800/40 focus:outline-none focus:ring-2 focus:ring-terracotta"
              placeholder="Tell us what you need — reservation, event, catering..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto inline-flex justify-center items-center rounded-full bg-terracotta hover:bg-terracotta-dark transition-colors px-8 py-3.5 font-semibold text-cream-light"
          >
            Send Inquiry
          </button>

          <p id="form-status" class="text-sm text-sage-dark hidden" role="status">
            Thanks! We've received your message and will reply shortly.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    // TODO: wire this up to a form backend (e.g. Formspree, Netlify Forms)
    // before launch — this currently only confirms client-side.
    form.reset();
    status?.classList.remove("hidden");
  });
</script>
